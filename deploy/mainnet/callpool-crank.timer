# CALLPOOL — 00:02 UTC, every day. MAINNET.
#
# Two minutes past midnight, not ten: the whole point of L19 is that holders are
# paid at 00:00 UTC, so every minute of offset is a minute of the promise not
# being kept. Two minutes is enough for the cluster's clock to be past the
# boundary as well as ours — the program refuses an early root and so does the
# crank.
#
# `Persistent=true` because a skipped day is a day nobody was paid: if the box
# is down at 00:02 the tick fires on boot instead of being dropped.

[Unit]
Description=CALLPOOL — settle and pay daily at 00:00 UTC (mainnet)
Documentation=https://github.com/AlphaArtrem/call-pool

[Timer]
OnCalendar=*-*-* 00:02:00 UTC
AccuracySec=10s
Persistent=true
Unit=callpool-crank.service

[Install]
WantedBy=timers.target
