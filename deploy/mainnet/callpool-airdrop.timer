# CALLPOOL — the payout backstop. MAINNET.
#
# The crank pays as part of settling (L19), so on a healthy day this finds
# nothing and exits. It exists for the unhealthy one: a crank that posted a root
# and then died before paying leaves money allocated and undelivered, and that
# is invisible from the outside.
#
# Every 6 hours. Cheap, idempotent — claims are write-once on chain, so a repeat
# run is refused by the program rather than paying twice — and it turns "nobody
# was paid until someone noticed" into "nobody was paid for at most six hours".

[Unit]
Description=CALLPOOL — pay any epoch the crank left unpaid (mainnet)
Documentation=https://github.com/AlphaArtrem/call-pool

[Timer]
OnCalendar=*-*-* 06,12,18:20:00 UTC
AccuracySec=60s
Persistent=true
Unit=callpool-airdrop.service

[Install]
WantedBy=timers.target
