# CALLPOOL — the second signer. BOX B. MAINNET.
#
# Box B does not trust box A's arithmetic: it fetches each epoch's published
# inputs over HTTP the way a stranger auditing the pool would, rebuilds the
# root, and refuses anything it cannot reproduce byte for byte.
#
#   install -m 0644 deploy/callpool-cosign.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now callpool-cosign.timer
#
# ⚠️ **`--callout-store` is the argument that makes this a second opinion
# rather than a second signature.** Without it, box B checks that the root
# follows from box A's inputs but not that those inputs are real — a compromised
# box A can fabricate callers and this will approve them. Point it at the store
# box B's OWN poller maintains, never at anything fetched from `--base`.
#
# **This path has never run against real divergence.** pump's callout API has no
# devnet surface, so through four rehearsals the corroboration only ever took
# its skip path. Twelve unit tests are its entire exercise. Watch the first
# mainnet epochs for it actually reporting a comparison.

# `--trust-proposer` is set here by L23 (owner, 2026-08-09): the second signer
# approves the crank host's proposal without re-deriving the epoch.
#
# It still refuses a proposal that does not match the published root, a
# directory belonging to another coin, and an allocation the pool cannot honour.
# What it no longer does is check that the published root is CORRECT.
#
# `--callout-store` is kept and still matters: it is the one input that cannot
# be re-derived from chain at all, so corroborating it is worth more here than
# anywhere else now that the arithmetic is checked once.
[Unit]
Description=CALLPOOL — co-sign post_epoch_root, re-derived here (mainnet)
Documentation=https://github.com/AlphaArtrem/call-pool
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=callpool
Group=callpool
WorkingDirectory=/srv/callpool
EnvironmentFile=/etc/callpool/signer.env
ExecStart=/usr/bin/node scripts/tools/cosign-remote.mjs \
  --base ${CALLPOOL_PUBLISH_BASE} \
  --multisig ${CALLPOOL_MULTISIG} \
  --keypair /etc/callpool/mainnet-signer-b.json \
  --approve-only \
  --trust-proposer \
  --callout-store epochs/callout-store.json

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/srv/callpool
