# CALLPOOL — how often the watchdog looks. BOX B. MAINNET.
#
# Every 15 minutes. It is cheap, it holds no keys, and the cost of looking too
# often is nothing while the cost of looking too rarely is the failure it
# exists to catch. Alert repetition is `--repeat` inside the tool, not here.

[Unit]
Description=CALLPOOL — watchdog, every 60s (devnet, 10-minute epochs)
Documentation=https://github.com/AlphaArtrem/call-pool

# Every 60 seconds, not the 15 minutes this file carried until 2026-08-09.
#
# It was copied from the mainnet timer when the profiles were split, and only
# the .service was re-tuned — so the watchdog checked LESS OFTEN THAN AN EPOCH
# and its verdict could be a quarter of an hour stale. A watchdog that samples
# slower than the thing it watches can miss an entire epoch's failure.
#
# The profile tests caught the crank, sampler and cosign timers and missed this
# one, which is the argument for testing every timer in a profile rather than
# the ones that came to mind.
[Timer]
OnCalendar=*:*:00
AccuracySec=30s
Persistent=true
Unit=callpool-watchdog.service

[Install]
WantedBy=timers.target
