# CALLPOOL — devnet, the two-hour run. 10-minute epochs.
#
# Sourced by an operator, not by systemd. These are the values that go on the
# `deploy-devnet.mjs` command line, gathered here because **`epoch_seconds` and
# `challenge_seconds` are written by `initialize` and are permanent** — there is
# no `set_params` and no admin path. A run deployed with the wrong number here
# is a coin that pays on the wrong clock for the rest of its life, and the only
# repair is a new program and a new coin.
#
#   set -a; . deploy/devnet/two_hour/profile.env; set +a
#
# Then check them with `preflight-initialize.mjs` before signing anything.

# ── the immutable clocks ───────────────────────────────────────────────────
CALLPOOL_EPOCH_SECONDS=600
CALLPOOL_CHALLENGE_SECONDS=120

# ── what the run is meant to cover ─────────────────────────────────────────
# TWELVE epochs in two hours, which is the first configuration that reaches
# every row in §5 that depends on epoch count.
#
# The binding constraint is B12. `LOCKOUT_EPOCHS` is 7, so a wallet that sells
# in epoch 0 is locked across epochs 1-7 and earns again at **epoch 8** — and
# epoch 8 has to close and settle for anyone to see it. That is nine epochs
# minimum; twelve leaves three spare, so the run can absorb a bad epoch without
# losing B12 with it.
#
# **Runs 3 and 4 both proved the lockout FIRES. Neither could prove it LIFTS.**
# That is the single largest hole in the gate and this profile exists to close
# it.
#
# Also reachable here and nowhere else so far:
#   D3   dust accumulating across epochs until it clears the threshold
#   D9   a crank stopped for 2+ epochs, then restarted, catching up oldest-first
#
CALLPOOL_RUN_EPOCHS=12
CALLPOOL_RUN_SECONDS=7200

# ── the trade loop ─────────────────────────────────────────────────────────
# Fees accrue ONLY while the coin is traded. Without this the pool stops
# growing, every epoch settles as dust-carry, and the payout path is never
# exercised — which looks like a clean run and proves nothing (§S3.14).
#
# It must also not graduate the coin: a buy-only loop walks the bonding curve to
# completion, and this run graduates LAST, deliberately. The wrapper alternates
# a buy with a matched sell for that reason. Check `readCurveState().complete`
# is still false at every epoch boundary, not only at the end.
CALLPOOL_TRADE_SOL=0.05

# ── rows this clock CANNOT reach ───────────────────────────────────────────
# Declared here rather than left to the report, so a run cannot quietly present
# four epochs as twelve epochs' worth of evidence. Empty means the clock reaches
# every row in §5 that depends on epoch count.
#
# 9 epochs at 600s is exactly the lockout arithmetic.
CALLPOOL_UNREACHABLE_ROWS=
