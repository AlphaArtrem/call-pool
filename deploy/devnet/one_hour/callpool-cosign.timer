# CALLPOOL — how often the second signer looks. BOX B. MAINNET.
#
# Every 5 minutes, not daily. The crank proposes at 00:02 and then waits for the
# threshold before it can pay, so every minute the co-signer is late is a minute
# holders are not paid — and L19's whole promise is payment at 00:00 UTC. A
# proposal sitting below threshold is an epoch that never settles at all.
# Frequent and cheap beats aligned and fragile: an idle tick reads the chain,
# finds nothing outstanding, and exits.

[Unit]
Description=CALLPOOL — co-sign outstanding epochs (mainnet)
Documentation=https://github.com/AlphaArtrem/call-pool

[Timer]
# 60 seconds, not the five minutes this file carried until 2026-08-09.
#
# The repo said `*:0/5` and both boxes had been hand-tuned to `*:*:00` — drift
# that survived three runs because nobody compared them. The profile split is
# what surfaced it.
#
# The interval is bounded by the crank's `--await-root`: the crank proposes,
# then blocks waiting for the second approval, and if this timer is slower than
# that wait the crank gives up on a root that was about to be posted. At
# `--await-root 400` a five-minute co-signer leaves 100 seconds of margin; a
# sixty-second one leaves ample, and it is the value run 3 settled fifteen
# epochs with.
OnCalendar=*:*:00
RandomizedDelaySec=30
AccuracySec=30s
Persistent=true
Unit=callpool-cosign.service

[Install]
WantedBy=timers.target
